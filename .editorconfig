root = true

[{src,tests,tools,experiments}/**.{cpp,hpp,c,h,m,mm}]
indent_style = space
indent_size = 2

[{tools,tests}/**.py]
indent_style = space
indent_size = 4
end_of_line = lf

[.githooks/*]
end_of_line = lf

[*.{json,toml,yml,yaml}]
indent_style = space
indent_size = 2

# Retained evidence and fixture bytes have no whitespace-normalization rule.
